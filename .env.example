# Set these in Render's Environment settings; never commit actual values.
NODE_ENV=production
APP_URL=https://YOUR-SERVICE.onrender.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET
TRUST_PROXY=1
# The Render blueprint generates BETTER_AUTH_SECRET automatically.
# Keep the same secret on subsequent deploys. APP_URL has no trailing slash.
# These variables are server-only: do not prefix them with VITE_.
# This file is a reference, not automatically loaded by npm start.
# Optional TURN relay for Cove on restrictive/mobile networks.
# Credentials are provided to signed-in call participants; use a dedicated relay account.
# TURN_URLS=turn:YOUR-RELAY:3478,turns:YOUR-RELAY:5349
# TURN_USERNAME=YOUR-RELAY-USERNAME
# TURN_CREDENTIAL=YOUR-RELAY-CREDENTIAL
